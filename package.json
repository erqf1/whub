{
  "name": "whub",
  "productName": "W Hub",
  "version": "1.1.0",
  "description": "Alle Programme von W Software an einem Ort: durchblättern, suchen, installieren und aktuell halten.",
  "main": "src/main.js",
  "private": true,
  "desktopName": "win.mert.WHub",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "node build.mjs && electron .",
    "icon": "electron tools/make-icon.js",
    "build": "node build.mjs && electron-builder",
    "build:win": "node build.mjs && electron-builder -w"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "erqf1",
    "email": "erqf1@users.noreply.github.com"
  },
  "devDependencies": {
    "electron": "43.8.7",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "allowScripts": {
    "electron@43.8.7": true,
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erqf1/whub.git"
  },
  "engines": {
    "node": ">=22.2"
  },
  "build": {
    "appId": "win.mert.WHub",
    "productName": "W Hub",
    "executableName": "WHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/*.js",
      "src/shared/**/*",
      "src/renderer/index.html",
      "src/renderer/style.css",
      "src/renderer/dist/**/*",
      "assets/**/*",
      "!assets/icon.ico",
      "!assets/icon.icns",
      "tools/selftest.js",
      "tools/siteshots.js",
      "package.json"
    ],
    "afterPack": "tools/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "erqf1",
      "repo": "whub"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "WHub-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "W Hub"
    },
    "portable": {
      "artifactName": "WHub-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Alle Programme von W Software installieren und aktuell halten",
      "artifactName": "WHub-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Keywords": "store;apps;install;update;vidline;clipline;textline;picline;"
        }
      },
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "WHub-${version}-amd64.${ext}"
    },
    "pacman": {
      "artifactName": "WHub-${version}-x86_64.${ext}"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WHub-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    }
  }
}
